{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignore": [
    // Loaded by URL (<Script src> in src/app/layout.tsx, and the service worker), not imported.
    "public/**",
    // Generated by `supabase gen types`; its unused helpers are expected.
    "src/lib/supabase/database.types.ts",
    // Kept for the in-app import planned in TODO 7.3.
    "src/components/timetable-csv-import.tsx"
  ]
}
