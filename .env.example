# Supabase — relational data, auth, row-level security
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase — Storage only (PDFs: report cards, receipts, message attachments).
# Only the bucket name is needed in the app; there is no client-side Firebase SDK.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase Admin SDK — server-side only, from a service-account key
# (Firebase Console > Project Settings > Service accounts > Generate new private key).
# Never commit the raw JSON key file — extract these three fields instead.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# SMS fallback — Android-phone relay (see src/lib/notifications/sms.ts)
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=

# WhatsApp click-to-chat sender number (school's phone, E.164 format)
NEXT_PUBLIC_SCHOOL_WHATSAPP_NUMBER=

# Web Push — generate a pair with `npm run vapid:keys`.
# Public key ships to the browser; private key stays server-side only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI put in the push request (mailto: or https:). Optional; defaults to
# a mailto if unset.
VAPID_SUBJECT=mailto:office@manthanvidyashram.in

# Vercel Cron — /api/cron/tick (Sheets sync poll + reminder dispatch) checks this
# against the Authorization header Vercel sends with scheduled invocations.
CRON_SECRET=

# Google Sheets sync (roster + academic-config data) — service account credentials.
# Create the service account in Google Cloud Console, enable the Sheets + Drive
# APIs, then share the target spreadsheet with GOOGLE_SHEETS_CLIENT_EMAIL.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
